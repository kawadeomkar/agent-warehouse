#!/usr/bin/env python3
"""The agents' server over the program: the MCP server through which Claude Code sessions in other projects read this
checkout's fleet, each read aw run as a child.

    <python> -I tools/aw-mcp --checkout=<checkout> --python=<python> --just=<just> --uv=<uv> --path=<PATH> \
        --home=<HOME> --program=<aw> --fleet-home=<folder> --state=<folder> [--vault-key-file=<file>] \
        [--data-home=<dir>] [--claude-config-dir=<dir>] [--attended=0|1] [--any-branch] [--browser=<command>]

Every value is an argument of the registered command: the server reads nothing of its environment that a project's
settings could set. It speaks MCP over stdio, one server per session, and its code is lib/claude_vm/cli/mcp_serve.py
over today's lib/claude_vm/mcp/ (docs/architecture/engine.md §16.3); nothing of today's product starts it. Run with
-I, so that no PYTHONPATH or user site-packages of the session's reaches it: it puts this checkout's lib/ on sys.path
itself.
"""

from __future__ import annotations

import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "lib"))  # the controller's package (docs/architecture/custom-code.md §7.10)

from claude_vm import plugin

plugin.own(str(REPO / "lib"))  # this checkout's package, never another's that sys.path had first

from claude_vm.cli import mcp_serve

if __name__ == "__main__":
    mcp_serve.main(sys.argv[1:])
