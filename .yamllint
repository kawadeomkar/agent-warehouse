---
extends: default

# Nothing git ignores: the vault, which ansible-vault encrypts (just vault),
# so it is no longer YAML, the environments and caches - and your own
# local.yml and hosts.yml, which CI never sees either.
ignore-from-file: .gitignore

rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
    check-keys: true
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
